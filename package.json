  },
  "homepage": "https://github.com/aurule/roll-it#readme",
  "dependencies": {
    "@discordjs/collection": "^2.1.1",
    "@opentelemetry/api": "^1.9.0",
    "better-sqlite3": "^12.6.2",
    "common-tags": "^1.8.2",
    "discord.js": "^14.25.1",
    "i18next": "^25.8.13",
    "i18next-fs-backend": "^2.6.1",
    "joi": "^18.0.2",
    "keyv": "^5.6.0",
    "mathjs": "^15.1.1",
    "pino": "^10.3.1",
    "pino-opentelemetry-transport": "^2.0.0",
    "posthog-node": "^5.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "ansi-colors": "^4.1.3",
    "cli-progress": "^3.12.0",
    "dev-null": "^0.1.1",
    "docsify-cli": "^5.0.0-rc.1",
    "dotenv": "^17.3.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prompts": "^2.4.2",
    "semver": "^7.7.4",
    "simpleflakes": "^4.0.0",
    "vitest": "^4.0.18",
    "y18n": "^5.0.8"
  },
  "scripts": {
    "test": "vitest",
    "test:once": "vitest --run",
